// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Identity {
  REAL
  ANON
}

enum ReportTargetType {
  POST
  REPLY
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum WingmanRole {
  USER
  ASSISTANT
}

enum RiskLevel {
  NONE
  ELEVATED
  CRISIS
}

enum BenchJourney {
  SOBRIETY
  DIVORCE
  GRIEF
  FATHERHOOD
  MENTAL_HEALTH
  CAREER_CHANGE
  OTHER
}

enum BenchRole {
  MENTOR
  SEEKER
}

enum BenchMatchStatus {
  PENDING
  ACTIVE
  DECLINED
  ENDED
}

model User {
  // id is the Supabase auth.users UUID — never generated app-side.
  id         String   @id
  email      String?  @unique
  phone      String?
  realName   String?
  anonHandle String   @unique
  isAdmin    Boolean  @default(false)
  createdAt  DateTime @default(now())

  // Heuristic tally for The Bench mentor badge. Increments per mentor reply
  // via a capped-per-day rule in bench server actions — not real session
  // timing (deferred to a real-product follow-up).
  hoursListened Float @default(0)

  checkIns        DailyCheckIn[]
  posts           Post[]
  replies         Reply[]
  reports         Report[]          @relation("Reporter")
  memberships     SquadMembership[]
  wingmanSessions WingmanSession[]
  benchProfile    BenchProfile?
  benchMessages   BenchMessage[]
}

model DailyCheckIn {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  sleepHours Float
  mood       Int
  moved      Boolean
  date       DateTime @default(now()) @db.Date

  @@unique([userId, date])
}

model Room {
  id          String  @id @default(cuid())
  slug        String  @unique
  displayName String
  description String?

  posts Post[]
}

model Post {
  id           String    @id @default(cuid())
  roomId       String?
  room         Room?     @relation(fields: [roomId], references: [id])
  squadId      String?
  squad        Squad?    @relation(fields: [squadId], references: [id])
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  identityUsed Identity
  body         String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  editedAt     DateTime?

  replies Reply[]
  reports Report[]

  @@index([roomId, createdAt])
  @@index([squadId, createdAt])
}

model Squad {
  id          String  @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  posts       Post[]
  memberships SquadMembership[]
}

model SquadMembership {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  squadId  String
  squad    Squad    @relation(fields: [squadId], references: [id])
  joinedAt DateTime @default(now())

  @@unique([userId, squadId])
  @@index([squadId])
}

model Reply {
  id           String    @id @default(cuid())
  postId       String
  post         Post      @relation(fields: [postId], references: [id])
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  identityUsed Identity
  body         String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  editedAt     DateTime?

  reports Report[]

  @@index([postId, createdAt])
}

model Report {
  id         String           @id @default(cuid())
  targetType ReportTargetType
  postId     String?
  post       Post?            @relation(fields: [postId], references: [id])
  replyId    String?
  reply      Reply?           @relation(fields: [replyId], references: [id])
  reporterId String
  reporter   User             @relation("Reporter", fields: [reporterId], references: [id])
  reason     String
  status     ReportStatus     @default(PENDING)
  createdAt  DateTime         @default(now())
}

model WingmanSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages WingmanMessage[]

  @@index([userId, updatedAt])
}

model WingmanMessage {
  id        String         @id @default(cuid())
  sessionId String
  session   WingmanSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      WingmanRole
  content   String
  riskLevel RiskLevel?
  escalated Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@index([sessionId, createdAt])
}

model BenchProfile {
  id        String       @id @default(cuid())
  userId    String       @unique
  user      User         @relation(fields: [userId], references: [id])
  journey   BenchJourney
  stageText String
  role      BenchRole
  bio       String?
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  matchesAsMentor BenchMatch[] @relation("MentorMatches")
  matchesAsSeeker BenchMatch[] @relation("SeekerMatches")

  @@index([journey, role, active])
}

model BenchMatch {
  id              String           @id @default(cuid())
  mentorProfileId String
  mentorProfile   BenchProfile     @relation("MentorMatches", fields: [mentorProfileId], references: [id])
  seekerProfileId String
  seekerProfile   BenchProfile     @relation("SeekerMatches", fields: [seekerProfileId], references: [id])
  status          BenchMatchStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  acceptedAt      DateTime?
  endedAt         DateTime?

  messages BenchMessage[]

  @@unique([mentorProfileId, seekerProfileId])
  @@index([mentorProfileId, status])
  @@index([seekerProfileId, status])
}

model BenchMessage {
  id           String     @id @default(cuid())
  matchId      String
  match        BenchMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User       @relation(fields: [senderId], references: [id])
  content      String
  identityUsed Identity
  createdAt    DateTime   @default(now())

  @@index([matchId, createdAt])
}
