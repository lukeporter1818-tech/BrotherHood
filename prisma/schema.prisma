// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReportTargetType {
  POST
  REPLY
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum WingmanRole {
  USER
  ASSISTANT
}

enum RiskLevel {
  NONE
  ELEVATED
  CRISIS
}

enum BenchMatchStatus {
  PENDING
  ACTIVE
  DECLINED
  ENDED
}

model User {
  // id is the Supabase auth.users UUID — never generated app-side.
  id         String   @id
  email      String?  @unique
  phone      String?
  anonHandle String   @unique
  isAdmin    Boolean  @default(false)
  createdAt  DateTime @default(now())

  // Personal-brief interest topics. Postgres text[]. Read on demand when the
  // user hits "Generate my brief" on /home. Bounded to 6 topics in the server
  // action; each ≤ 40 chars.
  interestTopics String[] @default([])

  checkIns         DailyCheckIn[]
  posts            Post[]
  replies          Reply[]
  reports          Report[]       @relation("Reporter")
  wingmanSessions  WingmanSession[]
  matchesInitiated BenchMatch[]   @relation("MatchesInitiated")
  matchesReceived  BenchMatch[]   @relation("MatchesReceived")
  benchMessages    BenchMessage[]
  briefs           Brief[]
  roomAvailability RoomAvailability[]
}

model DailyCheckIn {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  sleepHours Float
  mood       Int
  moved      Boolean?
  date       DateTime @default(now()) @db.Date

  @@unique([userId, date])
}

model Room {
  id          String  @id @default(cuid())
  slug        String  @unique
  displayName String
  description String?
  sortOrder   Int     @default(0)

  posts          Post[]
  availableUsers RoomAvailability[]
}

model Post {
  id        String    @id @default(cuid())
  roomId    String
  room      Room      @relation(fields: [roomId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  editedAt  DateTime?

  replies Reply[]
  reports Report[]

  @@index([roomId, createdAt])
}

model Reply {
  id        String    @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  editedAt  DateTime?

  reports Report[]

  @@index([postId, createdAt])
}

model Report {
  id         String           @id @default(cuid())
  targetType ReportTargetType
  postId     String?
  post       Post?            @relation(fields: [postId], references: [id])
  replyId    String?
  reply      Reply?           @relation(fields: [replyId], references: [id])
  reporterId String
  reporter   User             @relation("Reporter", fields: [reporterId], references: [id])
  reason     String
  status     ReportStatus     @default(PENDING)
  createdAt  DateTime         @default(now())
}

model WingmanSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages WingmanMessage[]

  @@index([userId, updatedAt])
}

model WingmanMessage {
  id        String         @id @default(cuid())
  sessionId String
  session   WingmanSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      WingmanRole
  content   String
  riskLevel RiskLevel?
  escalated Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@index([sessionId, createdAt])
}

model BenchMatch {
  id          String           @id @default(cuid())
  initiatorId String
  initiator   User             @relation("MatchesInitiated", fields: [initiatorId], references: [id])
  recipientId String
  recipient   User             @relation("MatchesReceived", fields: [recipientId], references: [id])
  context     String?
  status      BenchMatchStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?
  endedAt     DateTime?

  messages BenchMessage[]

  @@unique([initiatorId, recipientId])
  @@index([initiatorId, status])
  @@index([recipientId, status])
}

model BenchMessage {
  id        String     @id @default(cuid())
  matchId   String
  match     BenchMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User       @relation(fields: [senderId], references: [id])
  content   String
  createdAt DateTime   @default(now())

  @@index([matchId, createdAt])
}

model Brief {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  // Snapshot of topics used for THIS brief — user can edit interestTopics
  // afterward without rewriting history.
  topics    String[]
  // Full structured payload: { sections: [{ topic, items: [{ headline, blurb, url? }] }] }
  content   Json
  // Which model produced this run, for audit and future comparison.
  model     String

  @@index([userId, createdAt(sort: Desc)])
}

model RoomAvailability {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roomId])
  @@index([roomId])
}
